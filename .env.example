# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub.

# Genera una clave con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos. Si esta línea está comentada se usa SQLite (db.sqlite3).
# Si tu clave tiene símbolos, escríbelos codificados: @ -> %40, # -> %23, / -> %2F, : -> %3A
# DATABASE_URL=postgres://postgres:TU_CLAVE@localhost:5432/upbuy

# Correo. Sin estas líneas, los correos se imprimen en la consola de runserver.
# Ejemplo con Gmail (requiere verificación en 2 pasos y una "contraseña de aplicación"
# creada en https://myaccount.google.com/apppasswords):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# EMAIL_HOST_PASSWORD=la-contrasena-de-aplicacion-de-16-letras
# DEFAULT_FROM_EMAIL=UPBuy <tu-cuenta@gmail.com>
